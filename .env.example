# ==========================================
# Azure Service Configuration (REQUIRED)
# ==========================================

# Azure OpenAI (LLM)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5.2-chat
AZURE_API_VERSION=2025-04-01-preview
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Speech Services (STT & TTS)
AZURE_SPEECH_KEY=your_speech_service_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural

# ==========================================
# Email Configuration (REQUIRED for Forms)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=tbc_app_specific_password

# ==========================================
# Feature Flags (Optional)
# ==========================================
ENABLE_RECORDINGS=false
DEBUG=false
VERBOSE=false

USDA_API_KEY=your_USDA_api_key_here
NASS_API_KEY=your_NASS_api_key_here

# Tool Groups (Default: true)
ENABLE_USDA_TOOLS=true
ENABLE_NASS_TOOLS=true
ENABLE_FARMERS_GRANTS_TOOLS=true
