  "programs": {
    "EQIP": {
      "name": "Environmental Quality Incentives Program",
      "description": "Provides financial and technical assistance for conservation practices"
    },
    "CSP": {
      "name": "Conservation Stewardship Program", 
      "description": "Helps producers maintain and improve existing conservation systems"
    },
    "ACEP": {
      "name": "Agricultural Conservation Easement Program",
      "description": "Conserves agricultural lands and wetlands through easements"
    },
    "AMA": {
      "name": "Agricultural Management Assistance",
      "description": "Helps producers mitigate risk through diversification and conservation"
    },
    "RCPP": {
      "name": "Regional Conservation Partnership Program",
      "description": "Partners with eligible entities to target conservation at regional scale"
    },
    "RPP": {
      "name": "Regenerative Pilot Program",
      "description": "Provides targeted Farmer First assistance through EQIP and CSP"
    }
  },
